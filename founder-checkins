<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Founder — Check-in realtime</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&display=swap" rel="stylesheet" />
<style>
:root{
  --bg:#000; --text:#fff; --card:rgba(255,255,255,.06); --border:rgba(255,255,255,.12);
  --muted:rgba(255,255,255,.72); --accent:#8b5cf6;
  --ok:#22c55e; --warn:#fde047; --bad:#ef4444;
  --r:18px;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;min-height:100vh}
.wrap{max-width:1200px;margin:auto;padding:18px}
.top{position:sticky;top:0;z-index:50;background:rgba(0,0,0,.7);backdrop-filter:blur(6px);border-bottom:1px solid rgba(255,255,255,.08)}
.topin{max-width:1200px;margin:auto;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:10px;font-weight:900}
.badge{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,.14);border-radius:999px;padding:8px 10px;font-weight:900}
.badge.ok{border-color:rgba(34,197,94,.40)}
.badge.bad{border-color:rgba(239,68,68,.45)}
.badge.accent{border-color:rgba(139,92,246,.45)}
.muted{color:var(--muted)}
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:16px;margin-top:14px}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.input{flex:1;min-width:220px;background:#0f0f10;border:1px solid rgba(255,255,255,.15);border-radius:12px;color:#fff;padding:10px 12px;font-weight:800}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 12px;border-radius:12px;border:1px solid rgba(255,255,255,.16);background:#111;color:#fff;font-weight:900;cursor:pointer}
.btn.primary{background:var(--accent);border-color:rgba(139,92,246,.6);color:#000}
.small{font-size:12px}
.hr{height:1px;background:rgba(255,255,255,.08);margin:12px 0}

.table{width:100%;border-collapse:separate;border-spacing:0 10px}
.table th{font-size:12px;color:rgba(255,255,255,.65);text-align:left;padding:0 10px}
.table td{background:#0b0b0b;border:1px solid rgba(255,255,255,.10);padding:10px;border-left:none;border-right:none}
.table tr td:first-child{border-left:1px solid rgba(255,255,255,.10);border-top-left-radius:14px;border-bottom-left-radius:14px}
.table tr td:last-child{border-right:1px solid rgba(255,255,255,.10);border-top-right-radius:14px;border-bottom-right-radius:14px}

.pill{display:inline-flex;gap:8px;align-items:center;border:1px solid rgba(255,255,255,.14);border-radius:999px;padding:6px 10px;font-size:12px;font-weight:900}
.pill.ok{border-color:rgba(34,197,94,.40)}
.pill.warn{border-color:rgba(253,224,71,.40)}
.pill.bad{border-color:rgba(239,68,68,.45)}

.kbtn{padding:6px 8px;border-radius:10px;border:1px solid rgba(255,255,255,.16);background:transparent;color:#fff;font-weight:900;cursor:pointer;font-size:12px}
.kbtn:hover{border-color:rgba(255,255,255,.26)}
</style>
</head>
<body>

<header class="top">
  <div class="topin">
    <div class="brand">TRAPPERREO — Check-in realtime</div>
    <div class="row">
      <a class="badge accent" href="./founder.html">← Founder</a>
      <a class="badge" href="./scanner.html">📷 Scanner</a>
      <span class="badge ok">LIVE</span>
    </div>
  </div>
</header>

<main class="wrap">
  <div class="card">
    <div class="row">
      <input id="q" class="input" placeholder="Cerca per nome, email, ticketId…" />
      <button id="clear" class="btn">Reset</button>
      <span class="badge">Totale: <b id="count">—</b></span>
    </div>
    <div class="small muted" style="margin-top:10px">
      Questa lista si aggiorna in tempo reale appena lo scanner conferma un biglietto.
    </div>
  </div>

  <div class="card">
    <table class="table">
      <thead>
        <tr>
          <th>Ora</th>
          <th>Nome</th>
          <th>DOB</th>
          <th>Tipo</th>
          <th>Stato</th>
          <th>Drink (A / NA)</th>
          <th>Azioni</th>
        </tr>
      </thead>
      <tbody id="tbody"></tbody>
    </table>
    <div id="empty" class="muted small" style="display:none;margin-top:10px">Nessun check-in.</div>
  </div>
</main>

<script type="module">
import { app, onUser } from './auth.v2.js?v=6';
import {
  getFirestore, collection, query, orderBy, limit, onSnapshot, doc, updateDoc, increment
} from 'https://www.gstatic.com/firebasejs/12.5.0/firebase-firestore.js';

const db = getFirestore(app);

const qInput = document.getElementById('q');
const clearBtn = document.getElementById('clear');
const countEl = document.getElementById('count');
const tbody = document.getElementById('tbody');
const empty = document.getElementById('empty');

let ALL = []; // array di checkins
let UNSUB = null;

function lc(s){ return (s||'').toString().toLowerCase().trim(); }

function fmtTime(ts){
  try{
    if(!ts) return '—';
    // Firestore Timestamp
    const d = ts.toDate ? ts.toDate() : new Date(ts);
    return d.toLocaleTimeString('it-IT',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
  }catch{ return '—'; }
}

function statusPill(s){
  const v = lc(s);
  if(v === 'confirmed') return `<span class="pill ok">confirmed</span>`;
  if(v === 'flagged') return `<span class="pill warn">flagged</span>`;
  return `<span class="pill">${v||'—'}</span>`;
}

function applyFilter(){
  const term = lc(qInput.value);
  const filtered = !term ? ALL : ALL.filter(x=>{
    return lc(x.name).includes(term)
      || lc(x.email).includes(term)
      || lc(x.ticketId).includes(term)
      || lc(x.ticketType).includes(term);
  });
  render(filtered);
}

function render(arr){
  tbody.innerHTML = '';
  countEl.textContent = String(arr.length);
  empty.style.display = arr.length ? 'none' : 'block';

  const frag = document.createDocumentFragment();

  arr.forEach(x=>{
    const tr = document.createElement('tr');

    const alco = Number(x.drinksAlcoholic||0);
    const soft = Number(x.drinksSoft||0);

    tr.innerHTML = `
      <td>${fmtTime(x.checkedInAt)}</td>
      <td><b>${x.name || '—'}</b><div class="small muted">${x.email || ''}</div></td>
      <td>${(x.dob||'').toString().slice(0,10) || '—'}</td>
      <td>${x.ticketType || '—'}<div class="small muted">#${x.ticketId || '—'}</div></td>
      <td>${statusPill(x.status)}</td>
      <td><b>${alco}</b> / <b>${soft}</b></td>
      <td>
        <div class="row">
          <button class="kbtn" data-a-plus="${x.id}">A +</button>
          <button class="kbtn" data-a-minus="${x.id}">A -</button>
          <button class="kbtn" data-s-plus="${x.id}">NA +</button>
          <button class="kbtn" data-s-minus="${x.id}">NA -</button>
        </div>
      </td>
    `;
    frag.appendChild(tr);
  });

  tbody.appendChild(frag);

  // bind drink buttons
  tbody.querySelectorAll('[data-a-plus]').forEach(b=>{
    b.onclick = ()=> bump(b.getAttribute('data-a-plus'), 'drinksAlcoholic', +1);
  });
  tbody.querySelectorAll('[data-a-minus]').forEach(b=>{
    b.onclick = ()=> bump(b.getAttribute('data-a-minus'), 'drinksAlcoholic', -1);
  });
  tbody.querySelectorAll('[data-s-plus]').forEach(b=>{
    b.onclick = ()=> bump(b.getAttribute('data-s-plus'), 'drinksSoft', +1);
  });
  tbody.querySelectorAll('[data-s-minus]').forEach(b=>{
    b.onclick = ()=> bump(b.getAttribute('data-s-minus'), 'drinksSoft', -1);
  });
}

async function bump(id, field, delta){
  if(!id) return;
  const ref = doc(db, 'checkins', id);
  // evitare negativi: facciamo clamp lato client (poi se vuoi lo blindiamo anche con rules)
  const cur = ALL.find(x=>x.id===id);
  const now = Math.max(0, Number(cur?.[field]||0) + delta);
  const patch = {};
  patch[field] = now;
  await updateDoc(ref, patch);
}

function startRealtime(){
  // ultimi 500 check-in, realtime
  const q = query(collection(db,'checkins'), orderBy('checkedInAt','desc'), limit(500));
  UNSUB = onSnapshot(q, (snap)=>{
    const arr = [];
    snap.forEach(d=>{
      arr.push({ id:d.id, ...(d.data()||{}) });
    });
    ALL = arr;
    applyFilter();
  });
}

onUser(async(u)=>{
  if(!u){ location.href='./login.html?from=./founder-checkins.html'; return; }
  // (qui puoi anche mettere gate founder come nelle altre pagine, se vuoi)
  startRealtime();
});

qInput.addEventListener('input', ()=>{
  // micro debounce
  clearTimeout(applyFilter._t);
  applyFilter._t = setTimeout(applyFilter, 120);
});
clearBtn.onclick = ()=>{ qInput.value=''; applyFilter(); };

window.addEventListener('beforeunload', ()=>{ try{ UNSUB && UNSUB(); }catch{} });
</script>
</body>
</html>
